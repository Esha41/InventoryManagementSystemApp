{
  "compileOnSave": false,
  "compilerOptions": {
    "outDir": "./dist/out-tsc",
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "declaration": false,
    "experimentalDecorators": true,
    "moduleResolution": "node",
    "importHelpers": true,
    "target": "ES2022",
    "module": "ES2022",
    "useDefineForClassFields": false,
    "lib": [
      "ES2022",
      "dom"
    ],
    "baseUrl": "./",
    "paths": {
      "@app/*": [
        "src/app/*"
      ],
      "@core/*": [
        "src/app/core/*"
      ],
      "@constants/*": [
        "src/app/core/constants/*"
      ],
      "@shared/*": [
        "src/app/shared/*"
      ],
      "@components/*": [
        "src/app/shared/components/*"
      ],
      "@layouts/*": [
        "src/app/shared/layouts/*"
      ],
      "@utils/*": [
        "src/app/core/utils/*"
      ],
      "@services/*": [
        "src/app/core/services/*"
      ],
      "@interceptors/*": [
        "src/app/core/interceptors/*"
      ],
      "@guards/*": [
        "src/app/core/guards/*"
      ],
      "@models/*": [
        "src/app/core/models/*"
      ],
      "@environments/*": [
        "src/environments/*"
      ],
      "@pages/*": [
        "src/app/pages/*"
      ],
      "@features/*": [
        "src/app/features/*"
      ],
      "@auth/*": [
        "src/app/features/auth/*"
      ],
      "@dashboard/*": [
        "src/app/features/dashboard/*"
      ],
      "@warehouse/*": [
        "src/app/features/warehouse/*"
      ],
      "@requests/*": [
        "src/app/features/requests/*"
      ],
      "@supply/*": [
        "src/app/features/supply/*"
      ],
      "@inventory/*": [
        "src/app/features/inventory/*"
      ],
      "@assets/*": [
        "src/app/features/assets/*"
      ],
      "@workflow/*": [
        "src/app/features/workflow/*"
      ],
      "@allowance/*": [
        "src/app/features/allowance/*"
      ],
      "@forecast/*": [
        "src/app/features/forecast/*"
      ],
      "@admin/*": [
        "src/app/features/admin/*"
      ],
      "@settings/*": [
        "src/app/features/settings/*"
      ],
      "@notifications/*": [
        "src/app/features/notifications/*"
      ],
      "@profile/*": [
        "src/app/features/profile/*"
      ],
      "@bi-tool/*": [
        "src/app/features/bi-tool/*"
      ]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true,
    "extendedDiagnostics": {
      "checks": {
        "optionalChainNotNullable": "suppress"
      }
    }
  }
}